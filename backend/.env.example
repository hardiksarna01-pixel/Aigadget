# ==========================================
# AIGadget Backend - Environment Variables
# ==========================================

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aigadget

# Redis (Caching)
REDIS_URL=redis://localhost:6379

# AI - Claude (Primary)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# AI - OpenAI (Fallback + Embeddings)
OPENAI_API_KEY=sk-xxxxx

# Vector Database (Pinecone)
PINECONE_API_KEY=xxxxx
PINECONE_INDEX_URL=https://your-index-xxxx.svc.pinecone.io

# Scraping (Apify)
APIFY_API_TOKEN=apify_api_xxxxx

# Affiliate Tracking
AMAZON_AFFILIATE_TAG=aigadget-21
FLIPKART_AFFILIATE_ID=xxxxx
WALMART_AFFILIATE_ID=xxxxx
